# ============================================================
# 紫微斗数 Vercel 部署版 - 环境变量示例
# 复制为 .env.local（本地开发用），Vercel 部署时在控制台配
# ============================================================

# ---- AI 服务（所有人共用，从 Vercel 控制台统一配）----
# 必填：API 地址（OpenAI 兼容格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 必填：API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 必填：模型名
DEEPSEEK_MODEL=deepseek-chat

# ---- 管理员鉴权（生产部署必须改成强密码！）----
# 管理员登录后台用的密码（Bearer token 鉴权）
AI_ADMIN_PASSWORD=moss2026

# ---- 站点配置 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3101
NEXT_PUBLIC_SITE_NAME=紫微斗数排盘